{
    "name": "vscode-ciexml",
    "displayName": "The CiExml Programming Language Syntaxes Highlighting For Visual Studio Code",
    "version": "0.0.0",
    "publisher": "ciexml",
    "engines": { "vscode": "^1.80.0" },
    "categories": ["Programming Languages"],
    "contributes": {
        "languages": [{
            "id": "ciexml",
            "aliases": ["CiExml", "ciexml"],
            "extensions": [".exml"],
            "configuration": "./config.json"
        }],
        "grammars": [{
            "language": "ciexml",
            "scopeName": "source.ciexml",
            "path": "tml.json"
        }]
    }
}